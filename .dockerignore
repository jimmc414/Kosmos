# =============================================================================
# Docker Ignore File for Kosmos AI Scientist
# =============================================================================
#
# Excludes unnecessary files from Docker build context for:
# - Faster builds (smaller context)
# - Smaller final image
# - Better security (no secrets in image)
#
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation
docs/_build/
docs/.doctrees/
*.pdf

# Examples and test data
examples/
kosmos-figures/
test_data/

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml

# Logs and databases
*.log
logs/
*.db
*.sqlite
*.sqlite3

# Cache
cache/
.cache/
*.cache

# Environment and secrets
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
secrets/

# Development
.editorconfig
.flake8
.mypy_cache/
.ruff_cache/

# Docker
docker-compose.override.yml
Dockerfile.dev
.dockerignore

# Misc
*.md
!README.md
LICENSE
CONTRIBUTING.md
CHANGELOG.md
TODO.md

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Service data volumes and run output (owner data; never in the image).
# postgres_data/ is root-owned and unreadable from the build context.
neo4j_data/
neo4j_logs/
neo4j_import/
neo4j_plugins/
postgres_data/
redis_data/
.literature_cache/
artifacts/runs/
chroma_db/
.chroma_db/
.coverage.*

# Reference material the image never uses
kosmos-reference/
kosmos-claude-scientific-skills/
paper/
